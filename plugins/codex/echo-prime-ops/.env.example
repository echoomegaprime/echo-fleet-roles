# Runtime settings. Values shown here are non-secret defaults or examples.
ECHO_OAUTH_MCP_PORT=8796
ECHO_OAUTH_MCP_HOST=127.0.0.1
ECHO_OPS_AUTH_BASE_URL=https://auth.echo-op.com
ECHO_OPS_TENANT=echo-prime
# Set exactly one production allowlist using values obtained from Echo Auth.
ECHO_OPS_ALLOWED_SUBJECTS=
ECHO_OPS_ALLOWED_EMAILS=
# Local acceptance credentials are supplied only in the process environment.
ECHO_OPS_TEST_EMAIL=
ECHO_OPS_TEST_PASSWORD=
